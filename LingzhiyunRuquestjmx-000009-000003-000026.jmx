            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 后置处理程序" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters">P_token</stringProp>
              <stringProp name="script">def myToken = vars.get(&quot;P_token&quot;)

// 如果 token 不为空，把它设置成全局属性
if (myToken != null) {
    props.put(&quot;GLOBAL_TOKEN&quot;, myToken)
    log.info(&quot;✅ 全局 Token 已设置: &quot; + myToken)
} else {
    log.warn(&quot;⚠️ token 为空，请检查正则提取是否成功&quot;)
}</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PostProcessor>
