        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 预处理程序">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters">GLOBAL_TOKEN</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">// 从全局属性里取出 token（props 是 JMeter 的全局属性容器）
def globalToken = props.get(&quot;GLOBAL_TOKEN&quot;)

// 如果全局 token 存在，放入局部变量（vars），供当前请求使用
if (globalToken != null) {
    vars.put(&quot;GLOBAL_TOKEN&quot;, globalToken)
    log.info(&quot;✅ 已从全局获取 token: &quot; + globalToken)
} else {
    log.warn(&quot;⚠️ 全局 GLOBAL_TOKEN 为空，请检查是否已在 setUp 线程组中设置&quot;)
}</stringProp>
        </JSR223PreProcessor>
